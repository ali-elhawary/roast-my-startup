# systemd unit for the Roast My Startup booth server.
#
# Runs `npm start` (cross-env NODE_ENV=production tsx server/index.ts) as the
# `roast` user. The app reads its config from .env in WorkingDirectory via
# dotenv, so no EnvironmentFile is needed. Restart=always keeps the single
# stateful WebSocket process up across crashes; children (tsx, ffmpeg) are
# cleaned up with the control group on stop.
#
# Install:
#   sudo cp /opt/roast-my-startup/deploy/roast.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now roast

[Unit]
Description=Roast My Startup booth server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roast
Group=roast
WorkingDirectory=/opt/roast-my-startup
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3
# npm needs node on PATH when launched by systemd.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
# Give in-flight ffmpeg transcodes + GCS uploads a moment to finish on restart.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
