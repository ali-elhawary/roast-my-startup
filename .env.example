# ElevenLabs Agents credentials.
# Copy this file to .env and fill in real values. Never commit .env.
ELEVENLABS_API_KEY=sk_your_api_key_here
ELEVENLABS_AGENT_ID=agent_your_agent_id_here

# Port the Node server listens on (dev + prod). Vite dev server proxies to it.
PORT=3001

# Optional MongoDB Atlas. Leave MONGODB_URI blank to run fully in-memory.
# When set, completed sessions are written to the `sessions` collection and the
# /panel count is hydrated from an aggregation on startup.
MONGODB_URI=
MONGODB_DB=roast_my_startup

# Base URL used to build recording links in the follow-up email. For a LAN booth
# set this to the server's reachable address, e.g. http://192.168.1.50:3001.
PUBLIC_BASE_URL=
# From-address shown on the preview email.
EMAIL_FROM=Roast My Startup <booth@roast-my-startup.local>

# Token for the deletion endpoint (POST /api/admin/delete, header x-admin-token).
# Leave blank to disable the endpoint entirely.
ADMIN_TOKEN=

# Set to "true" when /station records video. Makes the video the deliverable:
# the video pipeline emails the watch link and the audio-only follow-up email
# is suppressed. Leave blank/false for the audio-only flow.
VIDEO_ENABLED=
# Client mirror of VIDEO_ENABLED (Vite only exposes VITE_-prefixed vars to the
# browser). Set both to the same value.
VITE_VIDEO_ENABLED=

# --- Cloud delivery (optional). All of the below is env-gated and OFF by
# default. With GCS_BUCKET unset and EMAIL_TRANSPORT unset/preview, the booth
# keeps the local behavior: it hosts videos under /videos, emails a /watch link,
# and writes preview .eml files to ./outbox. ---

# Google Cloud Storage bucket for finished videos + recordings. Set this to turn
# on cloud upload + 7-day signed Watch/Download links. Leave blank to host
# locally under /videos as before.
GCS_BUCKET=
# Path to the GCP service-account JSON key. The storage client reads this
# automatically (standard Google auth env var).
GOOGLE_APPLICATION_CREDENTIALS=

# Email transport. "preview" (default) writes a .eml to ./outbox; "smtp" sends
# for real via the SMTP_* settings below.
EMAIL_TRANSPORT=preview
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465); otherwise STARTTLS is used.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional Reply-To header on outgoing mail.
EMAIL_REPLY_TO=
